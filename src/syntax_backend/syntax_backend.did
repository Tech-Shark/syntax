type Admin = record { id : text; other : AdminInput };
type AdminInput = record { bio : opt text; plan : opt AdminRole };
type AdminResponse = variant { Ok : AdminResponseOk; Err : Error_1 };
type AdminResponseOk = variant { Message : text; Admin : Admin };
type AdminRole = variant { READ; WRITE };
type AnalysisResult = record {
  professional_summary : text;
  work_experience : text;
  skills : text;
};
type BioData = record {
  linkedin : opt text;
  marital_status : opt text;
  education : opt text;
  nationality : opt text;
  email : opt text;
  summary : opt text;
  contact_number : opt text;
  address : opt text;
  date_of_birth : opt text;
  full_name : opt text;
  github : opt text;
};
type CVAnalysisResponse = record {
  idx : text;
  result : AnalysisResult;
  request : CVUserInput;
};
type CVResponse = variant { Ok : CVAnalysisResponse; Err : Error_1 };
type CVUserInput = record {
  cv_template : text;
  cv_text : text;
  job_description : text;
};
type Credit = record { value : opt nat64; name : opt text };
type CreditResponse = variant { Ok : CreditResponseOk; Err : Error_1 };
type CreditResponseOk = variant { Message : text; Credit : Credit };
type Error = record { message : text };
type Error_1 = record { message : text };
type GrammarAnalysisResponse = record {
  idx : text;
  result : GrammarCheckResult;
  request : GrammarUserInput;
};
type GrammarCheckResult = record {
  general_suggestions : text;
  syntactic_errors : text;
  rewrite : text;
  grammatical_errors : text;
};
type GrammarResponse = variant { Ok : GrammarAnalysisResponse; Err : Error_1 };
type GrammarUserInput = record { "text" : text };
type HttpHeader = record { value : text; name : text };
type HttpResponse = record {
  status : nat;
  body : blob;
  headers : vec HttpHeader;
};
type IndividualNotificationForSingleUser = record {
  id : text;
  title : text;
  date_created : text;
  body : text;
  category : opt text;
  has_read : bool;
};
type NotificationForEverybody = record {
  id : text;
  title : text;
  date_created : text;
  body : text;
  category : opt text;
};
type NotificationForEverybodyInput = record {
  title : text;
  body : text;
  category : opt text;
};
type NotificationForEverybodyResponse = variant {
  Ok : NotificationForEverybodyResponseOk;
  Err : Error;
};
type NotificationForEverybodyResponseOk = variant {
  NotificationForEverybody : NotificationForEverybody;
  Message : text;
};
type NotificationForEverybodyResponseOk_1 = variant {
  NotificationForEverybody : vec NotificationForTier;
  Message : text;
};
type NotificationForEverybodyResponse_1 = variant {
  Ok : NotificationForEverybodyResponseOk_1;
  Err : Error_1;
};
type NotificationForSingleUser = record {
  notifications : vec vec record { text; IndividualNotificationForSingleUser };
  has_read : bool;
};
type NotificationForSingleUserResponse = variant {
  Ok : NotificationForSingleUserResponseOk;
  Err : Error_1;
};
type NotificationForSingleUserResponseOk = variant {
  NotificationForSingleUser : NotificationForSingleUser;
  Message : text;
};
type NotificationForSingleUserResponseOk_1 = variant {
  NotificationForSingleUser : IndividualNotificationForSingleUser;
  Message : text;
};
type NotificationForSingleUserResponse_1 = variant {
  Ok : NotificationForSingleUserResponseOk_1;
  Err : Error_1;
};
type NotificationForTier = record {
  id : text;
  title : text;
  date_created : text;
  body : text;
  category : opt text;
};
type NotificationForTierInput = record {
  title : text;
  for_freemium : bool;
  body : text;
  category : opt text;
};
type NotificationForTierResponse = variant {
  Ok : NotificationForTierResponseOk;
  Err : Error;
};
type NotificationForTierResponseOk = variant {
  Message : text;
  NotificationForTier : NotificationForTier;
};
type NotificationForTierResponseOk_1 = variant {
  Message : text;
  NotificationForTier : vec NotificationForTier;
};
type NotificationForTierResponse_1 = variant {
  Ok : NotificationForTierResponseOk_1;
  Err : Error_1;
};
type TransformArgs = record { context : blob; response : HttpResponse };
type User = record {
  id : text;
  cv_last_checked : opt text;
  other : UserInput;
  amount_of_credits : nat64;
};
type UserInput = record { bio : opt BioData; plan : text };
type UserResponse = variant { Ok : User; Err : Error_1 };
type UserResponse_1 = variant { Ok : text; Err : Error_1 };
service : () -> {
  add_credits_to_user : () -> (UserResponse);
  add_cv_analysis : (text, CVUserInput, AnalysisResult) -> (opt text);
  add_grammar_analysis : (text, GrammarUserInput, GrammarCheckResult) -> (
    opt text
  );
  add_new_admin : (text) -> (AdminResponse);
  add_new_notification_for_everybody : (NotificationForEverybodyInput) -> (
    NotificationForEverybodyResponse
  );
  add_new_notification_for_single_user : (NotificationForEverybodyInput) -> (
    NotificationForSingleUserResponse
  );
  add_new_notification_for_tier : (NotificationForTierInput) -> (
    NotificationForTierResponse
  );
  add_new_user : (UserInput) -> (UserResponse);
  add_single_credit_plan : (text, nat64, text) -> (CreditResponse);
  analyze_cv : (CVUserInput) -> (CVResponse);
  analyze_grammar : (GrammarUserInput) -> (GrammarResponse);
  cv_total_users : () -> (int64) query;
  delete_cv_analysis : (text) -> (text);
  delete_grammar_analysis : (text) -> (text);
  delete_single_credit_plan : (text, text) -> (CreditResponse);
  fetch_all_cv_analysis_for_identity : (text) -> (vec CVAnalysisResponse) query;
  fetch_all_grammar_analysis_for_identity : (text) -> (
    vec GrammarAnalysisResponse
  ) query;
  fetch_cv_analysis : (text, text) -> (opt CVAnalysisResponse) query;
  fetch_grammar_analysis : (text, text) -> (opt GrammarAnalysisResponse) query;
  fetch_single_cv_analysis_for_identity : (text, text) -> (
    vec CVAnalysisResponse
  ) query;
  get_all_admin_profile : () -> (vec Admin) query;
  get_all_credit_plan : () -> (vec Credit) query;
  get_all_cv_analysis_for_identity : () -> (vec CVAnalysisResponse) query;
  get_all_grammar_analysis_for_identity : () -> (
    vec GrammarAnalysisResponse
  ) query;
  get_all_notification_for_everybody : () -> (
    NotificationForEverybodyResponse_1
  ) query;
  get_all_notification_for_single_user : () -> (
    NotificationForSingleUserResponse
  ) query;
  get_all_notification_for_tier : () -> (NotificationForTierResponse_1) query;
  get_all_user_profile : () -> (vec User) query;
  get_cv_analysis : (text) -> (CVResponse) query;
  get_free_tier : () -> (opt text) query;
  get_grammar_analysis : (text) -> (GrammarResponse) query;
  get_single_admin : (text) -> (AdminResponse) query;
  get_single_cv_analysis_for_identity : (text) -> (
    vec CVAnalysisResponse
  ) query;
  get_single_user : () -> (UserResponse) query;
  get_user_role : () -> (UserResponse_1) query;
  get_users_by_tier : (text) -> (vec User) query;
  gr_total_users : () -> (int64) query;
  mark_notification_as_read : (text) -> (NotificationForSingleUserResponse_1);
  put_cv_analysis : (text, text, CVUserInput, AnalysisResult) -> (text);
  put_grammar_analysis : (text, text, GrammarUserInput, GrammarCheckResult) -> (
    text
  );
  remove_all_credit : (text) -> (AdminResponse);
  remove_all_cv_analysis : (text) -> (AdminResponse);
  remove_all_grammar : (text) -> (AdminResponse);
  remove_all_user : (text) -> (AdminResponse);
  remove_cv_analysis : (text, text) -> (text);
  remove_grammar_analysis : (text, text) -> (text);
  total_users : () -> (int64) query;
  transform : (TransformArgs) -> (HttpResponse) query;
  update_admin : (text, AdminInput) -> (AdminResponse);
  update_cv_analysis : (text, CVUserInput, AnalysisResult) -> (text);
  update_grammar_analysis : (text, GrammarUserInput, GrammarCheckResult) -> (
    text
  );
  update_single_credit_plan : (text, nat64, text) -> (CreditResponse);
  update_user : (UserInput) -> (UserResponse);
};
